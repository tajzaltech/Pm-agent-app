NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# On Vercel leave NEXT_PUBLIC_API_URL unset so the browser calls /v1 on the same domain.
# Also set on Vercel (backend + frontend):
#   MONGODB_URI=mongodb+srv://...  (Atlas, not localhost)
#   JWT_SECRET=a-long-random-string
#   NEXT_PUBLIC_GOOGLE_CLIENT_ID=
#   GOOGLE_CLIENT_ID=
#   GOOGLE_CLIENT_SECRET=
# And add https://YOUR-APP.vercel.app/auth/google/callback in Google Cloud.
