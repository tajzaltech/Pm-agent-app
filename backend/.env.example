# Copy to .env and fill in values. Never commit real secrets.

APP_ENV=development
APP_DEBUG=false
API_PREFIX=/v1
FRONTEND_ORIGIN=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=pm_agent

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Webhooks (public ingest endpoints)
WEBHOOK_INGEST_SECRET=
FRESHDESK_WEBHOOK_SECRET=

# AWS S3 (product docs)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PRESIGN_EXPIRES_SECONDS=300
S3_MAX_UPLOAD_BYTES=10485760

# Pinecone (repo + doc vectors — metadata stores IDs only, no PII)
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=pm-agent

# Optional OpenAI-compatible LLM for chat / embeddings
# OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_EMBED_MODEL=text-embedding-3-small

# Optional GitHub token for indexing private repos / higher rate limits
GITHUB_TOKEN=

# Google / Gmail sign-in (OAuth 2.0 Web client)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URIs: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
