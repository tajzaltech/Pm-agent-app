# Copy to .env and fill in values. Never commit real secrets.

# development | production
APP_ENV=development
APP_DEBUG=false
API_PREFIX=/v1

# Public URL of the Next.js app. Production must be https://...
FRONTEND_ORIGIN=http://localhost:3000
# Extra browser origins, comma-separated
EXTRA_CORS_ORIGINS=

# MongoDB (Atlas for any hosted API)
# Local: mongodb://127.0.0.1:27017
# Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/pm_agent?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=pm_agent

# Auth — production requires 32+ random characters
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Webhooks
WEBHOOK_INGEST_SECRET=
FRESHDESK_WEBHOOK_SECRET=

# AWS S3 (product docs). On AWS you can omit keys and use the task role.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PRESIGN_EXPIRES_SECONDS=300
S3_MAX_UPLOAD_BYTES=10485760

# Pinecone (optional — Mongo stores embeddings if unset)
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=pm-agent

# OpenAI-compatible LLM
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_EMBED_MODEL=text-embedding-3-small

GITHUB_TOKEN=

# Google / Gmail sign-in
# Authorized JavaScript origins: FRONTEND_ORIGIN
# Authorized redirect URIs: {FRONTEND_ORIGIN}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outbound email. Locally, mail is written to backend/var/outbox and
# reset/verify links are returned in the API response. For real mail:
SMTP_FROM=Ask PM <noreply@example.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
